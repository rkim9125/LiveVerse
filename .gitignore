# ── Copyrighted Bible data: never commit ──
# Everything under data/ is ignored except the public-domain sample.
data/*
!data/sample/
!data/sample/**

# Source / working files in the project root only
/*.json
/*.txt

# Backups and copyrighted source names, at any depth (defense in depth)
*.bak
NKJV*
nkjv*
ko_ko*
bible_data*
b_25.html

# Allowed exceptions
!/requirements.txt
!/package.json

# Local settings / OS
.claude/settings.local.json
.DS_Store

# Python / tooling
__pycache__/
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Realtime local-only data (the evaluation corpus lives outside the repo, in ~/liveverse-corpus)
realtime/backend/logs/
realtime/backend/eval/corpus/

# Audio and video: sermon recordings must never be committed
*.mp3
*.wav
*.m4a
*.mp4
*.webm

# Internal notes
PLAN.md
validation_report.md

# Node
node_modules/
